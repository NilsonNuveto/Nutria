APP_NAME=Nutria
APP_ENV=production
APP_KEY=base64:GERAR_COM_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://SEU-DOMINIO.vercel.app
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Supabase > Connect > Session pooler (porta 5432).
# Substitua [PASSWORD], [PROJECT_REF] e [POOLER_HOST].
DB_CONNECTION=pgsql
DB_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
DB_SCHEMA=nutria
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Administrador inicial da aplicação.
NUTRIA_ADMIN_NAME="Administrador Nutria"
NUTRIA_ADMIN_EMAIL=admin@exemplo.com
NUTRIA_ADMIN_SETUP_TOKEN=USE_UM_SEGREDO_LONGO_E_ALEATORIO
